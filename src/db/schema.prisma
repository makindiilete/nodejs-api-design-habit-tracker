// ─────────────────────────────────────────────────────────────────────────────
// PRISMA VERSION of src/db/schema.ts (same 5 tables, same columns, same cascades).
// Reference/learning copy: not wired into the app. To use it, see
// docs/14-prisma-schema-and-relations.md → "Wiring it up" (Prisma 7 needs prisma.config.ts).
//
// Reading guide:
//   - model Habit { … }      → a table. @@map("habits") = its REAL name in Postgres
//   - userId String @map("user_id") → field name in code vs column name in DB
//   - field with a model type (user User / entries Entry[]) → a RELATION field (not a DB column)
//   - @relation(fields, references, onDelete) → the FK equation (only on the FK owner)
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection URL lives in prisma.config.ts, not here.
}

/// People who sign up. `password` stores a HASH.
/// Parent of habits (one user → many habits).
model User {
  id        String    @id @default(uuid()) @db.Uuid
  email     String    @unique @db.VarChar(255)
  username  String    @unique @db.VarChar(50)
  password  String    @db.VarChar(255)
  firstName String?   @map("first_name") @db.VarChar
  lastName  String?   @map("last_name") @db.VarChar
  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at")

  habits Habit[] // far end is a fork → array. No column; the FK lives on Habit.

  @@map("users")
}

/// A habit a user wants to build.
/// Owns the equation: habits.user_id = users.id (cascade on user delete).
model Habit {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  name        String    @db.VarChar(200)
  description String?
  frequency   String    @db.VarChar(20) // 'daily' | 'weekly'
  targetCount Int?      @default(1) @map("target_count")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime? @default(now()) @map("created_at")
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade) // fork on MY end → I hold the equation
  entries   Entry[]
  habitTags HabitTag[]

  @@map("habits")
}

/// One completion ("tick") of a habit.
/// Owns the equation: entries.habit_id = habits.id (cascade on habit delete).
model Entry {
  id             String    @id @default(uuid()) @db.Uuid
  habitId        String    @map("habit_id") @db.Uuid
  completionDate DateTime  @default(now()) @map("completion_date")
  note           String?
  createdAt      DateTime? @default(now()) @map("created_at")
  updatedAt      DateTime? @default(now()) @updatedAt @map("updated_at")

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@map("entries")
}

/// Shared labels. No FK: tags survive when a user is deleted.
model Tag {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique @db.VarChar(50)
  color     String?   @default("#6b7280") @db.VarChar(7)
  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at")

  habitTags HabitTag[]

  @@map("tags")
}

/// LINK (bridge) table: habits ↔ tags is many-to-many.
/// Owns two equations: habit_id = habits.id, tag_id = tags.id.
/// Explicit (not implicit) because it has its own data: createdAt = when the tag was attached.
model HabitTag {
  id        String    @id @default(uuid()) @db.Uuid
  habitId   String    @map("habit_id") @db.Uuid
  tagId     String    @map("tag_id") @db.Uuid
  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at")

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([habitId, tagId]) // same tag can't be attached to a habit twice
  @@map("habits_tags")
}
